{
  "openapi": "3.0.3",
  "info": {
    "title": "Flight Booking Voice Agent — API",
    "version": "1.0.0",
    "description": "Backend for the (OneInbox) flight booking voice-agent demo.\n\nAll logic runs as PostgreSQL functions exposed through Supabase's auto REST layer — **there is no separate server**. Each endpoint is a `POST` to `/rest/v1/rpc/{function}` with a JSON body of arguments.\n\n**Auth is already wired** on this page (publishable key, safe for the browser — tables are protected by Row Level Security). Just open an endpoint, click **Try it out**, then **Execute**.\n\n**Demo data:** booking `ABC123` (Shivam Sharma) on route **SIN → NRT, 2026-10-08**. Flight `NS1156` is cheapest (−€60), `NS1120` is sold out, `NS1180` has low availability.\n\n**Note:** errors come back with HTTP 200 and an `{ \"error\": \"...\" }` body — always check for an `error` key."
  },
  "servers": [
    {
      "url": "https://ogxttimsdjgahwpzzjyv.supabase.co/rest/v1",
      "description": "Supabase (Flight Usecase project)"
    }
  ],
  "tags": [
    {
      "name": "Booking",
      "description": "Retrieve, modify and confirm a booking"
    },
    {
      "name": "Flights",
      "description": "Search flights and view seat maps"
    }
  ],
  "components": {
    "securitySchemes": {
      "apikey": {
        "type": "apiKey",
        "in": "header",
        "name": "apikey",
        "description": "Supabase publishable key"
      },
      "authorization": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Bearer <publishable key>"
      }
    }
  },
  "security": [
    {
      "apikey": [],
      "authorization": []
    }
  ],
  "paths": {
    "/rpc/get_booking": {
      "post": {
        "tags": [
          "Booking"
        ],
        "summary": "Get current booking",
        "description": "Retrieve the full booking: flight, seat, baggage, pricing breakdown and status.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "p_ref"
                ],
                "properties": {
                  "p_ref": {
                    "type": "string",
                    "description": "Booking reference",
                    "example": "ABC123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Booking object (or { error } if not found)"
          }
        },
        "operationId": "get_booking"
      }
    },
    "/rpc/search_flights": {
      "post": {
        "tags": [
          "Flights"
        ],
        "summary": "Search flights",
        "description": "Returns up to 6 flights for a route/date with `price_delta` (vs the current booking) and `available_seats`.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "p_origin",
                  "p_destination",
                  "p_date"
                ],
                "properties": {
                  "p_origin": {
                    "type": "string",
                    "description": "Origin airport (IATA)",
                    "example": "SIN"
                  },
                  "p_destination": {
                    "type": "string",
                    "description": "Destination airport (IATA)",
                    "example": "NRT"
                  },
                  "p_date": {
                    "type": "string",
                    "format": "date",
                    "description": "Departure date",
                    "example": "2026-10-08"
                  },
                  "p_ref": {
                    "type": "string",
                    "description": "Booking ref (for price delta baseline)",
                    "example": "ABC123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Object: { count, cheapest_flight_number, cheapest_base_fare, cheapest_price_delta, flights[] }. p_ref optional: without it deltas are null and cheapest is by lowest base_fare."
          }
        },
        "operationId": "search_flights"
      }
    },
    "/rpc/change_flight": {
      "post": {
        "tags": [
          "Booking"
        ],
        "summary": "Change flight",
        "description": "Move the booking to a new flight. Clears the current seat selection and recomputes the price.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "p_ref",
                  "p_new_flight_number"
                ],
                "properties": {
                  "p_ref": {
                    "type": "string",
                    "example": "ABC123"
                  },
                  "p_new_flight_number": {
                    "type": "string",
                    "description": "Target flight number",
                    "example": "NS1156"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated booking (status -> pending, boarding pass cleared). Errors: flight_not_found, already_on_flight"
          }
        },
        "operationId": "change_flight"
      }
    },
    "/rpc/get_seat_map": {
      "post": {
        "tags": [
          "Flights"
        ],
        "summary": "Get seat map",
        "description": "Returns all 180 seats plus free-first summary lists per type. Seat types: window (A/F, €0), aisle (C/D, €0), middle (B/E, €0), emergency_row (rows 12-13, €25); front rows 1-5 +€15.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "p_flight_number"
                ],
                "properties": {
                  "p_flight_number": {
                    "type": "string",
                    "example": "NS1156"
                  },
                  "p_summary_only": {
                    "type": "boolean",
                    "default": false,
                    "description": "true = omit the 180-seat array (tiny reply for the voice agent). Default false = full grid for the UI."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Object: summary fields first (incl. available_front_row_seats rows 1-5 +15 EUR, available_emergency_row_seats rows 12-13 +25 EUR), then seats[] unless p_summary_only=true."
          }
        },
        "operationId": "get_seat_map"
      }
    },
    "/rpc/change_seat": {
      "post": {
        "tags": [
          "Booking"
        ],
        "summary": "Change seat",
        "description": "Select a seat on the current flight. Applies the seat surcharge (window €0 / front row €15 / emergency row €25).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "p_ref",
                  "p_new_seat_number"
                ],
                "properties": {
                  "p_ref": {
                    "type": "string",
                    "example": "ABC123"
                  },
                  "p_new_seat_number": {
                    "type": "string",
                    "description": "Seat to select",
                    "example": "6A"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated booking (status -> pending). Errors: seat_not_found, seat_unavailable"
          }
        },
        "operationId": "change_seat"
      }
    },
    "/rpc/change_baggage": {
      "post": {
        "tags": [
          "Booking"
        ],
        "summary": "Change baggage",
        "description": "Set the number of checked bags. 1 bag is included; each extra bag is €45. Minimum 1.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "p_ref",
                  "p_baggage_count"
                ],
                "properties": {
                  "p_ref": {
                    "type": "string",
                    "example": "ABC123"
                  },
                  "p_baggage_count": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Total bags",
                    "example": 2
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated booking (or { error: min_one_bag })"
          }
        },
        "operationId": "change_baggage"
      }
    },
    "/rpc/quote_booking": {
      "post": {
        "tags": [
          "Booking"
        ],
        "summary": "Quote changes",
        "description": "Itemised price change vs the last confirmed state: `{ flight_change, seat_change, baggage_change, total_change }`. Negative total = refund/saving.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "p_ref"
                ],
                "properties": {
                  "p_ref": {
                    "type": "string",
                    "example": "ABC123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Quote breakdown"
          }
        },
        "operationId": "quote_booking"
      }
    },
    "/rpc/confirm_booking": {
      "post": {
        "tags": [
          "Booking"
        ],
        "summary": "Confirm booking",
        "description": "Locks the booking, issues a boarding pass reference, syncs CRM and flags email (email/PDF are stubs). Resets the quote baseline.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "p_ref"
                ],
                "properties": {
                  "p_ref": {
                    "type": "string",
                    "example": "ABC123"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Confirmation + boarding pass. Error: no_seat_selected if no seat chosen"
          }
        },
        "operationId": "confirm_booking"
      }
    },
    "/rpc/reset_demo": {
      "post": {
        "tags": [
          "Booking"
        ],
        "summary": "Reset demo booking",
        "description": "Demo helper: resets booking ABC123 to the starting state (NS1142, seat 23C, 1 bag, EUR 250, confirmed). Takes no arguments.",
        "operationId": "reset_demo",
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {}
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The booking restored to its starting state"
          }
        }
      }
    },
    "/rpc/get_seat_options": {
      "post": {
        "tags": [
          "Flights"
        ],
        "summary": "Seat options (agent)",
        "description": "Lightweight seat summary for the voice agent: flight_number, available_count, and available_window/aisle/middle/front_row/emergency_row_seats lists. No seats array.",
        "operationId": "get_seat_options",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "p_flight_number"
                ],
                "properties": {
                  "p_flight_number": {
                    "type": "string",
                    "example": "NS1156"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Seat summary object (no seats array)"
          }
        }
      }
    }
  }
}